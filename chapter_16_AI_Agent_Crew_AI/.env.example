# Sample environment file - copy to .env and fill in your real keys
# cp .env.example .env

# Groq
GROQ_API_KEY = your_groq_api_key_here
GROQ_MODEL = openai/gpt-oss-120b
GROQ_BASE_URL = https://api.groq.com/openai/v1

# Jira
JIRA_EMAIL = your_jira_email_here
JIRA_API_TOKEN = your_jira_api_token_here
JIRA_BASE_URL = https://your-org.atlassian.net/

# DeepSeek
DEEPSEEK_API_KEY = your_deepseek_api_key_here
DEEPSEEK_BASE_URL = https://api.deepseek.com
DEEPSEEK_MODEL = deepseek-chat

# OpenAI
OPENAI_API_KEY = your_openai_api_key_here
OPENAI_MODEL = gpt-4o
OPENAI_BASE_URL = https://api.openai.com/v1

# Claude (Anthropic)
ANTHROPIC_API_KEY = your_anthropic_api_key_here
ANTHROPIC_MODEL = claude-sonnet-4-5
ANTHROPIC_BASE_URL = https://api.anthropic.com

# Command Code (Cohere)
COMMAND_API_KEY = your_cohere_api_key_here
COMMAND_MODEL = command-a
COMMAND_BASE_URL = https://api.cohere.com/v2

# Open Code
OPENCODE_API_KEY = your_opencode_api_key_here
OPENCODE_MODEL = opencode-model
OPENCODE_BASE_URL = https://api.opencode.ai/v1

# OpenRouter
OPENROUTER_API_KEY = your_openrouter_api_key_here
OPENROUTER_MODEL = openai/gpt-4o
OPENROUTER_BASE_URL = https://openrouter.ai/api/v1
