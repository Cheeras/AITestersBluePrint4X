<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Salesforce Login Test Suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="com.salesforce.qa.listeners.ExtentReportListener"/>
    </listeners>
    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <groups>
            <run>
                <include name="valid"/>
                <include name="invalid"/>
            </run>
        </groups>
        <classes>
            <class name="com.salesforce.qa.tests.ValidLoginTest"/>
            <class name="com.salesforce.qa.tests.InvalidLoginTest"/>
        </classes>
    </test>
    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <groups>
            <run>
                <include name="valid"/>
                <include name="invalid"/>
            </run>
        </groups>
        <classes>
            <class name="com.salesforce.qa.tests.ValidLoginTest"/>
            <class name="com.salesforce.qa.tests.InvalidLoginTest"/>
        </classes>
    </test>
    <test name="Edge Tests">
        <parameter name="browser" value="edge"/>
        <groups>
            <run>
                <include name="valid"/>
                <include name="invalid"/>
            </run>
        </groups>
        <classes>
            <class name="com.salesforce.qa.tests.ValidLoginTest"/>
            <class name="com.salesforce.qa.tests.InvalidLoginTest"/>
        </classes>
    </test>
</suite>
